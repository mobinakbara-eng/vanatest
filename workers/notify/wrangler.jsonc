// Cloudflare Worker "vana-notify"
//  fetch: called only by the Supabase Edge Function "kontakt" (shared secret NOTIFY_SECRET).
//         E-mails the request to the team (Cloudflare Email Routing, verified address only)
//         and sends the visitor a confirmation (Brevo API).
//  email: Email Routing rule info@ → this Worker. Forwards to the team inbox and sends
//         first-time senders an automatic confirmation (Brevo API, once per address; KV "SEEN").
//   Deploy:  npx wrangler deploy -c workers/notify/wrangler.jsonc
//   Secrets: npx wrangler secret put NOTIFY_SECRET  -c workers/notify/wrangler.jsonc
//            npx wrangler secret put BREVO_API_KEY  -c workers/notify/wrangler.jsonc
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vana-notify",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "routes": [{ "pattern": "notify.vana-management.com", "custom_domain": true }],
  "workers_dev": false,
  "vars": {
    "MAIL_FROM": "info@vana-management.com",
    "MAIL_FROM_NAME": "VANA Website",
    "MAIL_TO": "vahidnaseri1988@gmail.com"
  },
  "send_email": [{ "name": "MAIL", "destination_address": "vahidnaseri1988@gmail.com" }],
  "kv_namespaces": [{ "binding": "SEEN", "id": "46a4fc36b62842f48ac944ec2c3d449d" }],
  "observability": { "enabled": true }
}
